; FIC Viewer Virtual HID UMDF2 driver V1.2.5
; Based on Microsoft Windows-driver-samples vhidmini2 UMDF2 INF (MS-PL).

[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%ProviderString%
DriverVer=10/01/2026,1.2.5.0
CatalogFile=FICVhidUm.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%DiskDescription%,,,

[SourceDisksFiles]
FICVhidUm.dll=1

[Manufacturer]
%ManufacturerString%=FIC,NTamd64.10.0...22000

[FIC.NTamd64.10.0...22000]
%DeviceDesc%=FICVhidUm,root\FICVhidUm

[FICVhidUm.NT]
CopyFiles=UMDriverCopy
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT

[FICVhidUm.NT.hw]
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT.hw
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.hw

[FICVhidUm.NT.Services]
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT.Services
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.Services

[FICVhidUm.NT.Filters]
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.Filters

[FICVhidUm.NT.Wdf]
UmdfService="FICVhidUm",FICVhidUm_Install
UmdfServiceOrder=FICVhidUm
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfFileObjectPolicy=AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction=Copy
UmdfFsContextUsePolicy=CanUseFsContext2

[FICVhidUm_Install]
UmdfLibraryVersion=2
ServiceBinary="%13%\FICVhidUm.dll"

[UMDriverCopy]
FICVhidUm.dll

[Strings]
ProviderString="FIC Viewer"
ManufacturerString="FIC Viewer"
DiskDescription="FIC Viewer Virtual HID UMDF2 Driver"
DeviceDesc="FIC Viewer Virtual Keyboard and Mouse"
